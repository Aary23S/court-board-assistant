{
  "rules": [
    {
      "condition": "Ready",
      "destinations": ["Hearing"],
      "status": "APPROVED",
      "source": "OFFICER_CONFIRMED",
      "source_note": "All Ready cases go to Hearing."
    },
    {
      "condition": "Unready + Cri.M.A.",
      "destinations": ["M.A."],
      "status": "APPROVED",
      "source": "OFFICER_CONFIRMED"
    },
    {
      "condition": "Unready + PWDVA Appln.",
      "destinations": ["D.V."],
      "status": "APPROVED",
      "source": "OFFICER_CONFIRMED"
    },
    {
      "condition": "Unready + R.C.C.",
      "destinations": ["R.C.C.", "S.C.C."],
      "status": "APPROVED",
      "source": "OFFICER_CONFIRMED"
    },
    {
      "condition": "Unready + S.C.C.",
      "destinations": ["R.C.C.", "S.C.C."],
      "status": "APPROVED",
      "source": "OFFICER_CONFIRMED"
    },
    {
      "condition": "Unready + Cri.M.A. + (N.B.W._Unready | B.W._Unready)",
      "destinations": ["M.A.", "N.B.W. / B.W."],
      "status": "APPROVED",
      "source": "OFFICER_CONFIRMED"
    },
    {
      "condition": "Unready + PWDVA Appln. + (N.B.W._Unready | B.W._Unready)",
      "destinations": ["D.V.", "N.B.W. / B.W."],
      "status": "APPROVED",
      "source": "OFFICER_CONFIRMED"
    },
    {
      "condition": "Unready + R.C.C. + (N.B.W._Unready | B.W._Unready)",
      "destinations": ["R.C.C.", "S.C.C.", "N.B.W. / B.W."],
      "status": "APPROVED",
      "source": "OFFICER_CONFIRMED"
    },
    {
      "condition": "Unready + S.C.C. + (N.B.W._Unready | B.W._Unready)",
      "destinations": ["R.C.C.", "S.C.C.", "N.B.W. / B.W."],
      "status": "APPROVED",
      "source": "OFFICER_CONFIRMED"
    },
    {
      "condition": "Stayed",
      "destinations": [],
      "status": "PENDING_OFFICER_DECISION",
      "source": "PENDING",
      "source_note": "Stayed cases remain unresolved."
    }
  ]
}
